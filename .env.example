# MQTT Configuration
# Set MQTT_ENV to 'local' for local Mosquitto or 'cloud' for HiveMQ Cloud

# Environment: local or cloud
MQTT_ENV=local

# Cloud MQTT Settings (HiveMQ Cloud)
# Get these from https://console.hivemq.cloud after creating a cluster
MQTT_CLOUD_BROKER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_CLOUD_PORT=8883
MQTT_CLOUD_USER=your_username
MQTT_CLOUD_PASS=your_password

# Database Configuration
# Set DB_MODE to 'json' for local JSON files or 'mongodb' for MongoDB Atlas

# Database Mode: json or mongodb
DB_MODE=json

# MongoDB Atlas Connection (for production/cloud)
# Get this from MongoDB Atlas: Connect → Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Note: For local development
# - MQTT_ENV=local (uses Mosquitto on localhost:1883)
# - DB_MODE=json (uses JSON files in reports/ directory)

# For production (Render.com/GitHub Actions)
# - MQTT_ENV=cloud (uses HiveMQ Cloud)
# - DB_MODE=mongodb (uses MongoDB Atlas)
